###
# General settings
###

# Accept the NVIDIA Omniverse EULA and privacy notice for Isaac Sim based images.
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y

# Base image that already contains Isaac Lab and Isaac Sim.
# Change this to a matching NGC image tag for headless-only runs if desired.
ISAACLAB_BASE_IMAGE=isaac-lab-base

# Project-specific image and container names.
TWIST2_LAB_IMAGE=twist2-lab
TWIST2_LAB_CONTAINER_NAME=twist2-lab

# Workspace layout inside the container.
DOCKER_TWIST2_LAB_PATH=/workspace/twist2_lab
DOCKER_GMR_PATH=/workspace/GMR
DOCKER_ISAACSIM_ROOT_PATH=/isaac-sim
DOCKER_USER_HOME=/root

# Optional host path for the external motion dataset.
# If it is empty or missing, runtime motion loading falls back to the bundled
# source/twist2_lab/data/motions copy inside the repository.
# This resolves to ../GMR relative to the repository root because the compose file lives in docker/.
HOST_GMR_ROOT=../../GMR
